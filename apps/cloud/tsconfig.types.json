{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "types": [
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
