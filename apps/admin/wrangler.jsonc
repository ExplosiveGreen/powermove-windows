{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "powermove-admin",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "98dbb6e46f4901896327e5ff4035d637",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.trypowermove.com", "custom_domain": true }],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // The server calls the API through a service binding (no public hop, and it
  // can pass the admin's IP on for the API's rate limits). API_ORIGIN is the
  // public URL the browser is sent to for Google sign-in and verification.
  "services": [{ "binding": "CLOUD", "service": "powermove-cloud" }],
  "vars": { "API_ORIGIN": "https://cloud.trypowermove.com" },
  "observability": { "enabled": true, "redact_query_string": true },
  "env": {
    // `vite dev` and `bun run preview`: plain fetch to the local cloud Worker.
    "local": {
      "vars": { "API_ORIGIN": "http://localhost:8787" }
    }
  }
}
